[configuration]
entry_symbol = "orrery_native_init"
compatibility_minimum = "4.4"

[libraries]
; One optimized binary per config/platform so the loader always finds it.
; (Web uses a standalone WASM module via JavaScriptBridge, not this extension.)
windows.debug.x86_64 = "res://bin/liborrery_native.dll"
windows.release.x86_64 = "res://bin/liborrery_native.dll"
linux.debug.x86_64 = "res://bin/liborrery_native.so"
linux.release.x86_64 = "res://bin/liborrery_native.so"
android.debug.arm64 = "res://bin/liborrery_native.android.arm64-v8a.so"
android.release.arm64 = "res://bin/liborrery_native.android.arm64-v8a.so"

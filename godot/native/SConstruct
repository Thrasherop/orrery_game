#!/usr/bin/env python
import os

# Build the godot-cpp bindings, then our extension against them.
env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Output straight into the project's bin/ so the .gdextension can load it via res://.
libname = "liborrery_native{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = env.SharedLibrary("../bin/" + libname, source=sources)

Default(library)
